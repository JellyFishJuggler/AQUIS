# Secrets
.env
.env.*
!.env.example

# Node
**/node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Next.js
.next/
front-end/.next/
out/

# Frontend
front-end/dist/
front-end/build/
front-end/.env
front-end/.env.*
!front-end/.env.example

# Backend
back-end/.env
back-end/.env.*
!back-end/.env.example

# Python
ml/venv/
**/__pycache__/
*.py[cod]
*.pyo

# ML data (raw/processed/selected/aligned/features are regenerated by the pipeline)
ml/data/raw/*
ml/data/processed/*
ml/data/data/*
ml/data/selected/*.csv
!ml/data/raw/nwic.py
!ml/data/raw/__init__.py
!ml/data/__init__.py
!ml/data/raw/.gitkeep
!ml/data/processed/.gitkeep
!ml/data/data/.gitkeep

# ML models/artifacts (large binary files, regenerated by training)
# NOTE: ml/models/*.joblib ARE committed on purpose (streamlit cloud needs them at runtime).
*.pkl
*.h5
*.pt
*.onnx

# ML training feature matrices (rebuilt by 06_features; app reads aligned/ at runtime)
ml/data/features/
# refresh pipeline runtime state (forecasts, journal, lock, candidate models)
ml/data/refresh/
# redundant 50MB wide export of table.parquet (app reads parquet)
ml/data/aligned/*.csv
# runtime/deploy logs
ml/app.log
ml/fetch.log
ml/soil_run.log
ml/logs/

# AI assistant embedding cache (regenerated on first index)
ml/agent/cache/

# Jupyter
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

.opencode
.agents
.paper
ml/data/features_traj/
