{
  "name": "aquis-backend",
  "version": "1.0.0",
  "description": "AQUIS – Aquifer Query and User Information System. Production-ready backend.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "import": "node scripts/importData.js",
    "import-assessments": "node scripts/ingestAssessments.js",
    "import-telemetry": "node scripts/ingestTelemetry.js",
    "setup": "npm run migrate && npm run import",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.0",
    "pg-copy-streams": "^7.0.0",
    "xlsx": "^0.18.5"
  }
}
